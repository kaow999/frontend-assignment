# Copy to .env.local to override. Next.js loads env files from this directory
# (apps/web) — a .env at the repo root is NOT read.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Every value below is optional; the app falls back to the same default in
# lib/eden.ts, so it runs with no env file at all.

# Where the browser reaches the API.
#
# Two things have to line up with the backend:
#   - the port must match the backend's PORT (default 4000)
#   - this origin must be allowed by the backend's WEB_ORIGIN, or CORS blocks
#     every request
#
# NEXT_PUBLIC_ means this value is inlined into the client bundle and is visible
# to anyone loading the page. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_URL=http://localhost:4000
